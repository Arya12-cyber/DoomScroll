{
  "name": "karmayogi-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "कर्मयोगी: डिजिटल क्लेश संहार // Karmayogi: The Klesha Slayer",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "bun --cwd frontend dev --host 0.0.0.0 --port 5173",
    "dev:frontend": "bun --cwd frontend dev --host 0.0.0.0 --port 5173",
    "dev:backend": "bun --cwd backend dev",
    "dev:all": "bun --cwd backend dev & bun --cwd frontend dev --host 0.0.0.0 --port 5173",
    "build": "bun --cwd frontend build",
    "build:frontend": "bun --cwd frontend build",
    "build:backend": "bun --cwd backend build",
    "preview": "bun --cwd frontend preview --host 0.0.0.0 --port 5173",
    "daemon": "bun backend/scripts/karmayogi-daemon.ts"
  },
  "dependencies": {
    "@esbuild/darwin-arm64": "/tmp/esbuild.tgz",
    "canvas-confetti": "^1.9.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "vite": "^6.0.0"
  }
}
